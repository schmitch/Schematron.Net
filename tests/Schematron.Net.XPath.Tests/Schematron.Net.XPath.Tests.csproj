<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Schematron.Net.XPath.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestData.cs" Link="TestData.cs" />
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Schematron.Net.Testing" />
    <Using Include="Schematron.Net.XPath" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Schematron.Net.XPath\Schematron.Net.XPath.csproj" />
  </ItemGroup>

</Project>
